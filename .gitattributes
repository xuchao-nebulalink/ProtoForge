# Normalise line endings in the repository so that a file committed from
# Windows and one committed from Linux CI do not show up as a whole-file diff.
* text=auto eol=lf

# Scripts that Windows tooling runs must keep CRLF locally.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Generated by CMake's Visual Studio generator; never committed, but if one
# ever is, it has to stay CRLF or MSBuild complains.
*.sln     text eol=crlf
*.vcxproj text eol=crlf

# Sources and build files are plain text.
*.h    text
*.hpp  text
*.cpp  text
*.cmake text
CMakeLists.txt text
*.json text
*.js   text
*.md   text

# Never touched by end-of-line conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.qm  binary
*.ttf binary
*.pdf binary
